      "output": "Yanzu muna da beraye masu watanni 4 da ba su da ciwon sukari da suka kasance masu ciwon sukari."
    },
    {
      "lang": "ig",
      "index": 0,
      "prompt_tokens": 72,
      "prompt_ms": 1384.434,
      "gen_tokens": 39,
      "gen_ms": 2039.724,
      "gen_words": 15,
      "gen_chars": 66,
      "output": "\"Ugbu a, anyị nwere ọnwa anọ ndị na-abụghị ndị shuga na-eri nri bụbu ndị shuga.\""
    },
    {
      "lang": "en",
      "index": 1,
      "prompt_tokens": 174,
